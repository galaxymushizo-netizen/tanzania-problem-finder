# Tanzania Problem Finder - Environment Variables
# Copy this to .env and fill in your values

# --- Google Custom Search API ---
# Free tier: 100 queries/day
# 1. Go to https://console.cloud.google.com
# 2. Enable "Custom Search API"
# 3. Create an API key
# 4. Create a Custom Search Engine at https://cse.google.com
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# --- Bing Web Search API ---
# Free tier: 1000 queries/month
# 1. Go to https://portal.azure.com
# 2. Create "Bing Search" resource (free)
# 3. Copy the API key
BING_API_KEY=

# --- Brave Search API ---
# Free tier: 2000 queries/month
# 1. Go to https://brave.com/search/api/
# 2. Sign up for free
# 3. Copy the API key
BRAVE_API_KEY=

# --- Tavily Search API ---
# Free tier: 1000 queries/month
# 1. Go to https://app.tavily.com
# 2. Sign up for free
# 3. Copy the API key
TAVILY_API_KEY=

# --- Database ---
# SQLite (default, no setup needed)
DATABASE_PATH=data/problems.db
# Uncomment for PostgreSQL:
# DATABASE_URL=postgresql://user:pass@localhost:5432/tanzania_problems

# --- Email (SMTP) - Gmail compatible ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_RECIPIENT=

# --- Agent Settings ---
MIN_PROBLEMS_TO_DISCOVER=50
TOP_OPPORTUNITIES=5
SEARCH_RESULTS_PER_QUERY=10
MAX_QUERIES_PER_RUN=30
DUPLICATE_THRESHOLD=0.75
SCHEDULER_INTERVAL_HOURS=3
LOG_LEVEL=INFO
